# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# pi: per-issue git worktrees (fix-issues-on-device skill)
_worktrees/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local
.env
server/.env

# typescript
*.tsbuildinfo

# coverage
coverage/

# generated native folders
/ios
/android
server/.go/

server/*.sqlite

# Firebase service account keys
*firebase-adminsdk*.json

# Firebase client config (contains API keys)
google-services.json
GoogleService-Info.plist

# Local QA media and design references (kept out of the public repo)
report/mobile-qa-*
report/cover-picker-figma-design.png
privacy-policy-screen.png

# Cover artwork is fetched at deploy time from the catalog (covers-sync -fetch);
# the images themselves stay out of the public repo.
server/assets/covers/*.png

# IP-to-city database (~130 MB) is fetched at deploy time (cmd/geoip-sync).
server/assets/geoip/

# Local release APKs and full emulator performance traces
/artifacts/animation-performance/

# Local Expo module build output
/modules/*/android/build/
/modules/*/android/.gradle/
/modules/*/android/.cxx/

# Local synthetic QA data, recordings, and operator artifacts
.data/

# Local uploaded event photos
.data/
server/.data/
